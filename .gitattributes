# Canonical cross-platform text representation. Windows tools may read LF directly;
# keeping checkout and CI bytes identical makes formatting checks reproducible.
* text=auto eol=lf

# Preserve binary assets byte-for-byte.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary

# Feature 011 historical/runtime evidence is SHA-bound as originally captured.
# Preserve CRLF/mixed capture bytes instead of normalizing sealed evidence.
specs/011-allergies-clinical-content-governance/evidence/** -text
# Restored historical reports retain SHA-bound CRLF; treat CR as a line ending
# while continuing to check other whitespace errors in these exact directories.
specs/011-allergies-clinical-content-governance/evidence/artifact-finalization/historical-*/** whitespace=cr-at-eol
# Retain the bundled upstream font licence in its original byte representation.
specs/011-allergies-clinical-content-governance/visual-baselines/source/fonts/ibm-plex-sans-arabic-LICENSE_FONT.txt -text

# Third-party skills are mirrored byte-for-byte from their locked upstream trees.
# Do not rewrite or reject upstream whitespace; project-authored files remain checked.
.agents/skills/** -whitespace
/specs/012-prescription-safety-governed-overrides/governance-remediation/integration-retention-manifest-v2.json -text whitespace=cr-at-eol
/specs/012-prescription-safety-governed-overrides/readiness/real-medicine-research/demonstration-data-proposal.md whitespace=-blank-at-eol

