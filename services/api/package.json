{
  "name": "@shifaa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude='dist/**' --exclude='test/supabase-runtime.integration.test.ts'",
    "test:integration": "vitest run test/identity-onboarding.integration.test.ts test/facility-onboarding.integration.test.ts test/admin-role-governance.integration.test.ts test/family-care.integration.test.ts",
    "test:supabase": "vitest run test/supabase-runtime.integration.test.ts --testTimeout=30000"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@shifaa/auth": "workspace:*",
    "@shifaa/contracts": "workspace:*",
    "@shifaa/core": "workspace:*",
    "@supabase/supabase-js": "2.112.2",
    "fastify": "5.11.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  }
}
